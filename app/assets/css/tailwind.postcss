@tailwind base;
@tailwind components;
@tailwind utilities;

/** SuisseIntl **/
@font-face {
  font-family: 'SuisseIntl';
  font-weight: 400;
  font-display: swap;
  src: url('../fonts/SuisseIntl-Regular.woff2') format('woff2');
} 
@font-face {
  font-family: 'SuisseIntl';
  font-weight: 500;
  font-display: swap;
  src: url('../fonts/SuisseIntl-Medium.woff2') format('woff2');
} 
@font-face {
  font-family: 'SuisseIntl';
  font-weight: 600;
  font-display: swap;
  src: url('../fonts/SuisseIntl-SemiBold.woff2') format('woff2');
}

:root,
.theme-dark {
  color-scheme: dark;
  --color-fcfcfc: #0b0f14;
  --color-12161e: #f5f7fb;
  --color-656976: #c9d1e0;
  --color-c2c3c7: #7b869d;
  --color-91949b: #9aa6bd;
  --color-232730: #ffffff;
  --color-575a64: #d3d9e6;
  --surface-base: 11 15 20;
  --surface-sidebar: 14 18 25;
  --surface-card: 18 24 32;
  --surface-3: 26 34 46;
  --surface-4: 36 45 60;
  --surface-search: 14 19 27;
  --input-bg: 12 16 23;
  --input-bg-hover: 16 22 30;
  --input-bg-focus: 10 14 20;
  --input-border: 96 113 142;
  --input-border-hover: 126 146 182;
  --input-border-focus: 140 180 255;
  --input-outline: 92 137 222;
  --input-shadow: 0 0 0;
  --border-muted: 255 255 255;
  --border-soft: 255 255 255;
  --ghost-bg: 15 20 28;
  --ghost-bg-hover: 22 29 40;
  --ghost-shadow: 0 1px 1px rgba(0,0,0,0.45),0 0 0 1px rgba(255,255,255,0.1);
  --ghost-shadow-hover: 0 10px 24px rgba(0,0,0,0.5),0 0 0 1px rgba(255,255,255,0.18);
  --shadow-card: 0 18px 40px rgba(0,0,0,0.55);
  --shadow-float: 0 12px 28px rgba(0,0,0,0.45);
  --shadow-float-strong: 0 16px 36px rgba(0,0,0,0.6);
  --shadow-soft: 0 2px 4px rgba(0,0,0,0.45);
  --button-secondary-shadow: rgba(0,0,0,0.45);
  --gradient-a: 64 92 196;
  --gradient-b: 64 176 140;
}

.theme-light {
  color-scheme: light;
  --color-fcfcfc: #fcfcfc;
  --color-12161e: #12161e;
  --color-656976: #656976;
  --color-c2c3c7: #c2c3c7;
  --color-91949b: #91949b;
  --color-232730: #232730;
  --color-575a64: #575a64;
  --surface-base: 252 252 252;
  --surface-sidebar: 255 255 255;
  --surface-card: 255 255 255;
  --surface-3: 238 239 239;
  --surface-4: 227 227 229;
  --surface-search: 255 255 255;
  --input-bg: 245 247 250;
  --input-bg-hover: 239 243 248;
  --input-bg-focus: 255 255 255;
  --input-border: 200 208 220;
  --input-border-hover: 175 186 201;
  --input-border-focus: 92 137 222;
  --input-outline: 92 137 222;
  --input-shadow: 17 26 74;
  --border-muted: 0 0 0;
  --border-soft: 0 0 0;
  --ghost-bg: 255 255 255;
  --ghost-bg-hover: 255 255 255;
  --ghost-shadow: 0 1px 1px rgba(255,255,255,0),0 0 0 1px rgba(87,90,100,0.12);
  --ghost-shadow-hover: 0 1px 1px rgba(0,0,0,0.15),0 0 0 1px rgba(87,90,100,0.2);
  --shadow-card: 0 12px 28px rgba(17,26,74,0.08);
  --shadow-float: 0 8px 24px rgba(17,26,74,0.08);
  --shadow-float-strong: 0 8px 24px rgba(17,26,74,0.12);
  --shadow-soft: 0 1px 2px rgba(17,26,74,0.08);
  --button-secondary-shadow: rgba(38,38,44,10%);
  --gradient-a: 126 167 233;
  --gradient-b: 148 239 183;
}

body, html {
  @apply h-full bg-fcfcfc text-12161e;
}
body {
  @apply text-base m-0 leading-[1.6]
}
.auth-root {
  @apply bg-fcfcfc text-12161e h-full;
  font-family: 'Inter', sans-serif;
  line-height: 1.6;
}
.auth-scroll {
  @apply bg-fcfcfc text-12161e h-screen overflow-y-auto relative
}
.auth-shell {
  @apply relative min-h-screen flex justify-center items-center box-border;
  padding: clamp(80px, 9vh, 200px) 0px
}
.auth-content {
  @apply relative flex-grow
}
.auth-panel {
  @apply max-w-md w-full my-0 mx-auto py-0 px-5 box-border
}
.auth-stack {
  @apply grid gap-8 text-center
}
.auth-group {
  @apply grid gap-4 [&:not(:last-child)]:mb-6
}
.form-field {
  @apply text-656976 block relative py-2.25 px-3 text-base cursor-text transition-all duration-200;
  --input-background: var(--input-bg);
  --input-border-color: var(--input-border);
  --input-outline-color: var(--input-outline);
  background-color: rgb(var(--input-background) / 1);
  box-shadow:
    inset 0 0 0 var(--input-border,1px) rgb(var(--input-border-color) / 1),
    0 1px 2px rgb(var(--input-shadow) / 0.25),
    0 0 0 var(--input-outline,0px) rgb(var(--input-outline-color) / 0.35);
  border-radius: 5px;
  &:hover {
    --input-background: var(--input-bg-hover);
    --input-border-color: var(--input-border-hover);
  }
  &:focus-within {
    --input-background: var(--input-bg-focus);
    --input-border-color: var(--input-border-focus);
    --input-outline: 2px;
    --input-outline-color: var(--input-outline);
  }
}
.form-field input {
  @apply placeholder:transition-all placeholder:duration-200 placeholder:text-c2c3c7 hover:placeholder-91949b placeholder:focus-within:text-91949b
}
.form-field textarea {
  @apply placeholder:transition-all placeholder:duration-200 placeholder:text-c2c3c7 hover:placeholder-91949b placeholder:focus-within:text-91949b
}
.form-field-inner {
  @apply relative flex items-center
}
.form-input {
  @apply w-full block h-[22px] leading-[22px] m-0 p-0 text-inherit tracking-[-0.125px] appearance-none bg-[initial] border-none outline-none
}
.form-textarea {
  @apply w-full block min-h-[96px] leading-6 m-0 p-0 text-inherit tracking-[-0.125px] appearance-none bg-[initial] border-none outline-none resize-none;
}
.form-select {
  @apply w-full block h-[32px] leading-[22px] m-0 p-0 text-inherit tracking-[-0.125px] appearance-none bg-[initial] border-none outline-none;
}
.btn-primary {
  box-shadow: 0 0 0 var(--button-outline,0px) var(--button-outline-color,#5c89de4d), inset 0 -1px 1px 0px var(--button-inner-shadow,rgba(38 38 44 / 15%)), inset 0 var(--button-shine-y,1px) 0 0 var(--button-shine,rgba(255 255 255 / 25%)), 0 1px 2px 0 var(--button-shadow,rgba(38 38 44 / 25%));
  @apply text-white bg-[var(--button-background,#5c89de)] table border-none relative font-semibold text-sm m-0 outline-none select-none whitespace-nowrap text-center appearance-none rounded-[5px] leading-5 tracking-[-0.125px] py-[10px] px-6 cursor-pointer transition scale-[var(--button-scale,1)] w-full duration-200;
  &:hover {
    --button-shadow: rgba(38 38 44 / 50%);
    --button-background: #3577da
  }
  &:active {
    --button-outline: 3px;
    --button-scale: 0.975
  }
}
.btn-label {
  @apply relative z-10 flex justify-center items-center gap-2 min-h-[1.25rem];
  transition: transform 0.2s ease 0s, opacity 0.2s ease 0s;
  &.loading {
    opacity: 0;
    transform: translateY(12px) scale(0.75);
  }
}
.link-muted {
  @apply no-underline transition-colors duration-200 text-xs font-medium m-0 leading-normal text-91949b hover:text-575a64
}
.auth-title {
  @apply font-[inherit] m-0 leading-[1.4] tracking-[-0.125px] text-232730 font-semibold text-xl
}
.auth-subtitle {
  @apply m-0 leading-normal text-656976 text-sm font-medium
}
.btn-secondary {
  --button-border-radius: 5px;
  @apply text-575a64 table border-none relative font-semibold text-sm m-0 outline-none select-none whitespace-nowrap text-center appearance-none rounded-[var(--button-border-radius)] leading-5 tracking-[-0.125px] py-[10px] px-6 cursor-pointer transition scale-[var(--button-scale,1)] w-full duration-300;
  background-color: rgb(var(--surface-3) / 1);
  &:before {
    @apply absolute inset-[1.34px] rounded-[calc(var(--button-border-radius)-1px)];
    background-color: rgb(var(--surface-base) / 1);
    box-shadow: 0 2px 4px var(--button-secondary-shadow);
    content: '';
  }
  &:hover {
    background-color: rgb(var(--surface-4) / 1);
  }
  &:active {
  --button-scale: 0.975
  }
}
.auth-footer {
  @apply transition duration-200 m-0 absolute z-10 left-2/4 text-center translate-x-[-50%] bottom-6 text-[10px] max-w-[260px] text-c2c3c7
}
.auth-footer a {
  @apply no-underline transition duration-200 text-91949b hover:text-656976
}
.auth-topbar {
  @apply z-10 fixed left-0 top-0 right-0 p-6 box-border flex items-center justify-between transition-all duration-200
}
.back-link svg {
  --icon-color: currentColor;
  --icon-size: 20px;
  @apply flex-[0_0_20px]
}
.icon-20 {
  @apply w-[var(--icon-size)] h-[var(--icon-size)]
}
.back-link-content {
  @apply relative z-10 flex items-center gap-2 min-h-[20px] transition duration-200
}
.back-link {
  @apply text-[var(--button-color,var(--color-91949b))] relative text-sm font-[inherit] tracking-[-0.125px] py-[10px] pr-4 pl-3 font-semibold scale-[var(--button-scale,1)] transition duration-200 opacity-100;
  &:hover {
    --button-color: var(--color-656976)
  }
  &:active {
    --button-scale: 0.975
  }
  &.router-link-exact-active {
    @apply pointer-events-none opacity-0
  }
}
.legal-text {
  @apply text-left text-xs font-medium text-91949b
}
.legal-link {
  @apply font-medium bg-none border-none inline 
  cursor-pointer p-0 m-0 relative leading-5 
  no-underline text-current;
  --line-background-size: 100%;
  --line-background-delay: 0.15s;
  --line-stroke-dashoffset: 46;
  --line-stroke-duration: 0.15s;
  --line-stroke-easing: linear;
  --line-stroke-delay: 0s;
  font-style: inherit;
  font-variant: inherit;
  font-stretch: inherit;
  font-size: inherit;
  font-family: inherit;
  font-optical-sizing: inherit;
  font-kerning: inherit;
  font-feature-settings: inherit;
  font-variation-settings: inherit;
  &:hover {
    --line-background-size: 0%;
    --line-background-delay: 0s;
    --line-stroke-dashoffset: 26;
    --line-stroke-duration: 0.3s;
    --line-stroke-easing: cubic-bezier(0.3,1.5,0.5,1);
    --line-stroke-delay: 0.195s;
  }
  & span {
    background-image: linear-gradient(0deg, currentcolor 0%, currentcolor 100%);
    background-position: 100% 100%;
    background-repeat: no-repeat;
    background-size: var(--line-background-size) 1px;
    transition: background-size 0.2s linear var(--line-background-delay);
    transform: translateZ(0px);
    line-height: 20px;
  }
}
.section-kicker {
  @apply text-base leading-5 font-semibold mb-3 text-232730;
  letter-spacing: -.01em;
  &:before {
    @apply w-2 h-4 mr-2 inline-block relative top-0.5;
    border-radius: 1px;
    background: linear-gradient(165deg,#cd4545 0%,#e97e7e 92%);
    content: '';
  }
  &.in::before {
    background: linear-gradient(165deg,#50cd45 0%,#82e97e 92%);
  }
}
.page-title {
  @apply text-7xl text-12161e font-semibold mt-8;
  line-height: 4.5rem;
  letter-spacing: -.03em;
}
.page-subtitle {
  @apply text-2xl leading-8 text-575a64 mt-2;
  letter-spacing: -.01em;
  font-weight: inherit;
}
.projects-layout {
  @apply relative z-10;
}
.projects-header {
  @apply max-w-3xl;
}
.projects-panel {
  @apply mt-8 p-6;
}
.projects-form {
  @apply grid gap-5;
}
.projects-field {
  @apply grid gap-2;
}
.projects-label {
  @apply text-xs font-semibold uppercase tracking-[0.2em] text-91949b;
}
.projects-actions {
  @apply flex flex-wrap gap-3;
}
.projects-error {
  @apply mt-6 text-sm text-656976;
}
.projects-grid {
  @apply mt-8 grid gap-4 sm:grid-cols-2 xl:grid-cols-3;
}
.projects-card {
  @apply px-5 py-5 text-left transition;
}
.projects-card-top {
  @apply flex items-center justify-between text-xs text-91949b;
}
.projects-card-id {
  @apply font-semibold;
}
.projects-card-pill {
  @apply rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.2em];
}
.status-pill {
  @apply border;
}
.status-pill--active {
  background-color: rgba(80, 210, 140, 0.15);
  color: #7ee3b0;
  border-color: rgba(80, 210, 140, 0.35);
}
.status-pill--paused {
  background-color: rgba(255, 196, 87, 0.15);
  color: #ffd27a;
  border-color: rgba(255, 196, 87, 0.35);
}
.status-pill--archived {
  background-color: rgba(140, 156, 190, 0.18);
  color: #c6cfdf;
  border-color: rgba(140, 156, 190, 0.35);
}
.theme-light .status-pill--active {
  background-color: rgba(53, 174, 105, 0.16);
  color: #1f7a4b;
  border-color: rgba(53, 174, 105, 0.35);
}
.theme-light .status-pill--paused {
  background-color: rgba(244, 170, 54, 0.2);
  color: #9a5a00;
  border-color: rgba(244, 170, 54, 0.4);
}
.theme-light .status-pill--archived {
  background-color: rgba(115, 129, 163, 0.18);
  color: #4b5873;
  border-color: rgba(115, 129, 163, 0.35);
}
.projects-card-title {
  @apply mt-3 text-lg font-semibold text-12161e;
}
.projects-card-desc {
  @apply mt-2 text-sm text-656976 leading-6;
}
.projects-empty {
  @apply mt-8 text-sm text-91949b;
}
.reports-layout {
  @apply relative z-10;
}
.reports-header {
  @apply max-w-4xl;
}
.reports-auth-hint {
  @apply mt-4 text-xs text-91949b;
}
.reports-error {
  @apply mt-6 text-sm text-656976;
}
.reports-panel {
  @apply relative mt-8 overflow-hidden rounded-2xl border p-6;
  border-color: rgb(var(--border-soft) / 0.1);
  background:
    radial-gradient(120% 100% at 100% 0%, rgb(var(--gradient-a) / 0.2) 0%, transparent 55%),
    radial-gradient(90% 100% at 0% 100%, rgb(var(--gradient-b) / 0.16) 0%, transparent 62%),
    rgb(var(--surface-card) / 0.92);
  box-shadow: var(--shadow-card);
}
.reports-panel::before {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  background: linear-gradient(180deg, rgb(255 255 255 / 0.04), transparent 35%);
}
.reports-panel-head {
  @apply relative z-10 flex flex-col gap-4 md:flex-row md:items-start md:justify-between;
}
.reports-panel-eyebrow {
  @apply text-[10px] font-semibold uppercase tracking-[0.22em] text-91949b;
}
.reports-panel-title {
  @apply mt-2 text-2xl font-semibold tracking-[-0.02em] text-12161e;
}
.reports-panel-subtitle {
  @apply mt-1 text-sm text-656976;
}
.reports-panel-actions {
  @apply flex shrink-0 items-center;
}
.reports-export {
  @apply h-9 px-4 text-xs font-semibold uppercase tracking-[0.14em];
}
.reports-tabs {
  @apply relative z-10 mt-6 grid gap-2 sm:grid-cols-3;
}
.reports-tab {
  @apply inline-flex h-10 items-center justify-center rounded-xl border px-4 text-sm font-semibold text-12161e transition;
  border-color: rgb(var(--border-soft) / 0.1);
  background-color: rgb(var(--surface-3) / 0.55);
  box-shadow: var(--shadow-soft);
}
.reports-tab:hover {
  background-color: rgb(var(--surface-4) / 0.9);
  transform: translateY(-1px);
}
.reports-tab.is-active {
  border-color: rgb(var(--gradient-a) / 0.35);
  background: linear-gradient(
    135deg,
    rgb(var(--gradient-a) / 0.3),
    rgb(var(--gradient-b) / 0.26)
  );
  box-shadow: var(--shadow-float);
}
.reports-tab:disabled {
  @apply cursor-not-allowed opacity-50;
}
.reports-stats {
  @apply relative z-10 mt-4 grid gap-2 sm:grid-cols-2 xl:grid-cols-4;
}
.reports-stat {
  @apply rounded-xl border px-4 py-3;
  border-color: rgb(var(--border-soft) / 0.1);
  background-color: rgb(var(--surface-3) / 0.55);
}
.reports-stat-label {
  @apply text-[11px] uppercase tracking-[0.15em] text-91949b;
}
.reports-stat-value {
  @apply mt-2 text-2xl font-semibold tracking-[-0.02em] text-12161e;
}
.reports-output-card {
  @apply relative z-10 mt-4 rounded-2xl border p-4;
  border-color: rgb(var(--border-soft) / 0.12);
  background-color: rgb(var(--surface-base) / 0.62);
}
.reports-output-head {
  @apply mb-3 flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between;
}
.reports-output-title {
  @apply text-sm font-semibold uppercase tracking-[0.16em] text-91949b;
}
.reports-generated-at {
  @apply text-xs text-91949b;
}
.reports-output {
  @apply block min-h-[360px] w-full resize-y rounded-xl border p-4 text-[12px] leading-6 text-12161e outline-none;
  border-color: rgb(var(--border-soft) / 0.1);
  background-color: rgb(var(--surface-3) / 0.58);
  box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.18);
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New, monospace;
}
.dashboard-layout {
  @apply relative z-10 grid gap-6;
}
.dashboard-loading {
  @apply absolute inset-0 z-20 flex items-start justify-center pt-6;
  background-color: rgb(var(--surface-base) / 0.35);
  backdrop-filter: blur(1px);
}
.dashboard-loading-card {
  @apply flex items-center gap-2 rounded-full border px-4 py-2 text-xs font-semibold uppercase tracking-[0.14em] text-12161e;
  border-color: rgb(var(--border-soft) / 0.18);
  background-color: rgb(var(--surface-card) / 0.95);
  box-shadow: var(--shadow-float);
}
.dashboard-loading-dot {
  @apply inline-block h-2 w-2 rounded-full;
  background-color: rgb(var(--gradient-a) / 1);
  animation: dashboard-pulse 1s ease-in-out infinite;
}
@keyframes dashboard-pulse {
  0%, 100% {
    opacity: 0.35;
    transform: scale(0.9);
  }
  50% {
    opacity: 1;
    transform: scale(1.1);
  }
}
.dashboard-hero {
  @apply rounded-2xl border p-6;
  border-color: rgb(var(--border-soft) / 0.08);
  background:
    radial-gradient(120% 140% at 0% 0%, rgb(var(--gradient-a) / 0.2), transparent 52%),
    radial-gradient(120% 120% at 100% 100%, rgb(var(--gradient-b) / 0.16), transparent 55%),
    rgb(var(--surface-card) / 0.92);
}
.dashboard-hero-head {
  @apply flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between;
}
.dashboard-title {
  @apply mt-2 text-4xl sm:text-5xl font-semibold tracking-[-0.03em] text-12161e;
}
.dashboard-subtitle {
  @apply mt-3 text-base text-575a64;
}
.dashboard-quick-actions {
  @apply flex flex-wrap items-center gap-2;
}
.dashboard-search {
  @apply mt-6 grid gap-2;
}
.dashboard-search-label {
  @apply text-xs font-semibold uppercase tracking-[0.18em] text-91949b;
}
.dashboard-search-controls {
  @apply flex flex-col gap-2 sm:flex-row sm:items-center;
}
.dashboard-search-field {
  @apply w-full max-w-2xl;
}
.dashboard-search-actions {
  @apply flex items-center gap-2;
}
.dashboard-search-btn {
  @apply h-9 px-4 text-xs font-semibold uppercase tracking-[0.12em];
}
.dashboard-search-meta {
  @apply text-xs text-91949b;
}
.dashboard-error {
  @apply text-sm text-656976;
}
.dashboard-metrics {
  @apply grid gap-3 sm:grid-cols-2 xl:grid-cols-4;
}
.dashboard-metric {
  @apply rounded-xl p-4;
}
.dashboard-metric-label {
  @apply text-[11px] uppercase tracking-[0.15em] text-91949b;
}
.dashboard-metric-value {
  @apply mt-2 text-3xl font-semibold tracking-[-0.02em] text-12161e;
}
.dashboard-metric-meta {
  @apply mt-2 text-xs text-656976;
}
.dashboard-grid {
  @apply grid gap-4 xl:grid-cols-2;
}
.dashboard-card {
  @apply rounded-2xl p-5;
}
.dashboard-card-head {
  @apply flex items-center justify-between gap-3;
}
.dashboard-card-title {
  @apply text-lg font-semibold text-12161e;
}
.dashboard-card-link {
  @apply text-xs font-semibold uppercase tracking-[0.16em] text-91949b transition;
}
.dashboard-card-link:hover {
  @apply text-12161e;
}
.dashboard-statuses {
  @apply mt-4 grid gap-3;
}
.dashboard-status-row {
  @apply grid gap-2;
}
.dashboard-status-top {
  @apply flex items-center justify-between text-xs text-91949b;
}
.dashboard-status-track {
  @apply h-2 rounded-full overflow-hidden;
  background-color: rgb(var(--surface-4) / 0.65);
}
.dashboard-status-fill {
  @apply h-full rounded-full;
  background: linear-gradient(90deg, rgb(var(--gradient-a)), rgb(var(--gradient-b)));
}
.dashboard-list {
  @apply mt-4 grid gap-2;
}
.dashboard-empty {
  @apply text-sm text-91949b;
}
.dashboard-list-item,
.dashboard-project-item,
.dashboard-comment-item {
  @apply rounded-lg border px-3 py-3;
  border-color: rgb(var(--border-soft) / 0.08);
  background-color: rgb(var(--surface-3) / 0.45);
}
.dashboard-item-title {
  @apply text-sm font-semibold text-12161e;
}
.dashboard-item-meta {
  @apply mt-1 text-xs text-91949b;
}
.dashboard-item-right {
  @apply text-xs text-656976;
}
.dashboard-list-item {
  @apply flex items-center justify-between gap-3;
}
.dashboard-project-item {
  @apply grid gap-2;
}
.dashboard-project-top {
  @apply flex items-center justify-between gap-3;
}
.dashboard-comment-item .dashboard-item-title {
  @apply font-medium;
}
.tasks-layout {
  @apply relative z-10;
}
.tasks-header {
  @apply max-w-4xl;
}
.tasks-header-actions {
  @apply mt-4 flex justify-center;
  @apply flex-col items-center gap-2;
}
.tasks-auth-hint {
  @apply text-xs text-91949b;
}
.tasks-panel {
  @apply mt-8 p-6;
}
.tasks-form {
  @apply grid gap-5;
}
.tasks-grid {
  @apply grid gap-4 md:grid-cols-2;
}
.tasks-field {
  @apply grid gap-2;
}
.tasks-label {
  @apply text-xs font-semibold uppercase tracking-[0.2em] text-91949b;
}
.tasks-actions {
  @apply flex flex-wrap gap-3;
}
.tasks-error {
  @apply mt-6 text-sm text-656976;
}
.tasks-filter {
  @apply mt-6 flex flex-col gap-4 xl:flex-row xl:items-end xl:justify-between;
}
.tasks-filter-field {
  @apply w-full xl:max-w-xs;
}
.tasks-board {
  @apply mt-10 grid gap-6 lg:grid-cols-3;
}
.task-column {
  @apply rounded-2xl border p-5 min-h-[420px];
  background-color: rgb(var(--surface-3) / 0.35);
  border-color: rgb(var(--border-soft) / 0.08);
}
.task-column.is-over {
  border-color: rgb(var(--gradient-a) / 0.5);
  box-shadow: var(--shadow-float);
}
.task-column-header {
  @apply mb-4 flex items-center justify-between;
}
.task-column-title {
  @apply text-sm font-semibold text-12161e;
}
.task-column-count {
  @apply text-xs text-91949b;
}
.task-list {
  @apply grid gap-3;
}
.task-card {
  @apply px-4 py-4 text-left transition cursor-grab;
}
.task-card:active {
  cursor: grabbing;
}
.task-card.is-dragging {
  opacity: 0.6;
}
.task-card-top {
  @apply flex items-center justify-between text-xs text-91949b;
}
.task-project {
  @apply font-semibold text-91949b;
}
.task-card-title {
  @apply mt-2 text-sm font-semibold text-12161e;
}
.task-card-desc {
  @apply mt-2 text-xs text-656976 leading-5;
}
.task-card-meta {
  @apply mt-3 text-[11px] text-91949b flex flex-wrap gap-3;
}
.task-empty {
  @apply text-xs text-91949b text-center py-6;
}
.task-priority {
  @apply rounded-full px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.2em] border;
}
.task-priority--high {
  background-color: rgba(255, 104, 104, 0.2);
  color: #ff8f8f;
  border-color: rgba(255, 104, 104, 0.4);
}
.task-priority--medium {
  background-color: rgba(255, 196, 87, 0.18);
  color: #ffd27a;
  border-color: rgba(255, 196, 87, 0.4);
}
.task-priority--low {
  background-color: rgba(80, 210, 140, 0.16);
  color: #7ee3b0;
  border-color: rgba(80, 210, 140, 0.35);
}
.theme-light .task-priority--high {
  background-color: rgba(228, 70, 70, 0.18);
  color: #8f1e1e;
  border-color: rgba(228, 70, 70, 0.35);
}
.theme-light .task-priority--medium {
  background-color: rgba(244, 170, 54, 0.2);
  color: #9a5a00;
  border-color: rgba(244, 170, 54, 0.4);
}
.theme-light .task-priority--low {
  background-color: rgba(53, 174, 105, 0.16);
  color: #1f7a4b;
  border-color: rgba(53, 174, 105, 0.35);
}
.tasks-stats {
  @apply flex flex-wrap gap-4 px-4 py-3 text-xs text-91949b;
}
.tasks-stat {
  @apply flex items-center gap-2;
}
.tasks-stat-value {
  @apply text-12161e font-semibold;
}
.comments-layout {
  @apply relative z-10;
}
.comments-header {
  @apply max-w-4xl;
}
.comments-auth-hint {
  @apply mt-3 text-xs text-91949b;
}
.comments-error {
  @apply mt-5 text-sm text-656976;
}
.comments-grid {
  @apply mt-7 grid gap-3 lg:grid-cols-2;
}
.comments-thread {
  @apply rounded-xl p-4;
}
.comments-thread-head {
  @apply flex items-start justify-between gap-3;
}
.comments-thread-main {
  @apply min-w-0;
}
.comments-thread-project {
  @apply text-[10px] uppercase tracking-[0.18em] text-91949b;
}
.comments-thread-title {
  @apply mt-1 text-sm font-semibold text-12161e leading-5;
}
.comments-thread-badges {
  @apply flex shrink-0 items-center gap-2;
}
.comments-thread-pill {
  @apply rounded-full border px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.14em] text-91949b;
  border-color: rgb(var(--border-soft) / 0.15);
  background-color: rgb(var(--surface-3) / 0.45);
}
.comments-thread-pill--status {
  @apply text-12161e;
}
.comments-thread-desc {
  @apply mt-2 text-xs text-656976 leading-5;
}
.comments-replies {
  @apply mt-3 grid gap-2;
}
.comments-reply {
  @apply flex gap-2;
}
.comments-avatar {
  @apply h-7 w-7 shrink-0 rounded-full border text-[10px] font-semibold text-12161e flex items-center justify-center;
  border-color: rgb(var(--border-soft) / 0.14);
  background-color: rgb(var(--surface-4) / 0.85);
}
.comments-reply-content {
  @apply min-w-0 rounded-md border px-3 py-2;
  background-color: rgb(var(--surface-3) / 0.42);
  border-color: rgb(var(--border-soft) / 0.08);
}
.comments-reply-meta {
  @apply flex items-center gap-2 text-[11px] text-91949b;
}
.comments-reply-author {
  @apply font-semibold text-12161e;
}
.comments-reply-body {
  @apply mt-1 break-words text-xs leading-5 text-656976;
}
.comments-more {
  @apply pl-9 text-[11px] text-91949b;
}
.comments-empty {
  @apply text-xs text-91949b;
}
.comments-compose {
  @apply mt-3 grid gap-2;
}
.comments-label {
  @apply text-[10px] font-semibold uppercase tracking-[0.18em] text-91949b;
}
.comments-compose-field {
  @apply px-3 py-1.5;
}
.comments-compose-textarea {
  @apply min-h-[44px] max-h-[120px] text-sm leading-5;
}
.comments-actions {
  @apply flex justify-end;
}
.comments-submit {
  @apply h-8 px-3 text-xs;
}
.modal-overlay {
  @apply fixed inset-0 z-50 flex items-start justify-center px-4 py-10;
  background: rgba(5, 7, 12, 0.6);
}
.modal-card {
  @apply w-full max-w-2xl rounded-2xl border p-6;
  background-color: rgb(var(--surface-card) / 0.98);
  border-color: rgb(var(--border-soft) / 0.08);
  box-shadow: var(--shadow-card);
}
.modal-card--compact {
  @apply max-w-lg;
}
.modal-header {
  @apply flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between;
}
.modal-title {
  @apply text-2xl font-semibold text-12161e;
}
.modal-close {
  @apply text-xs font-semibold text-91949b;
  background-color: rgb(var(--surface-3) / 0.6);
  border: 1px solid rgb(var(--border-soft) / 0.08);
  padding: 6px 10px;
  border-radius: 999px;
}
.modal-close:hover {
  @apply text-12161e;
  background-color: rgb(var(--surface-4) / 1);
  box-shadow: var(--shadow-soft);
}
.modal-actions {
  @apply flex flex-wrap gap-3 justify-end;
}
.modal-body {
  @apply mt-4 text-sm text-656976 leading-6;
}
.welcome-card {
  @apply relative overflow-hidden rounded-2xl border px-6 py-8;
  background-color: rgb(var(--surface-card) / 0.9);
  border-color: rgb(var(--border-soft) / 0.08);
  box-shadow: var(--shadow-card);
}
.welcome-card::after {
  content: '';
  position: absolute;
  inset: -40% -10% auto -10%;
  height: 60%;
  background: radial-gradient(circle at top, rgb(var(--gradient-a) / 0.35), transparent 60%);
  pointer-events: none;
}
.welcome-title {
  @apply text-4xl sm:text-5xl font-semibold tracking-[-0.03em] text-12161e;
  position: relative;
  z-index: 1;
}
.welcome-highlight {
  @apply text-12161e;
  background: linear-gradient(120deg, rgb(var(--gradient-a)), rgb(var(--gradient-b)));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.welcome-subtitle {
  @apply mt-3 text-base sm:text-lg text-575a64;
  position: relative;
  z-index: 1;
}
.action-row {
  @apply flex gap-3 mt-4;
}
.btn-primary-solid {
  @apply relative text-white rounded-lg px-4 h-9 m-px font-medium outline-none whitespace-nowrap 
  cursor-pointer text-center leading-4 items-center justify-center inline-flex;
  background-color: rgba(83,120,255,1);
  box-shadow: 0 0 0 1px rgba(83,120,255,1),0 8px 20px rgba(0,0,0,0.4),0 2px 4px rgba(0,0,0,0.35);
  transition: box-shadow 0.2s ease 0s, background-color 0.2s ease 0s, border-color 0.2s ease 0s;
  min-height: 36px;
  &::after {
    @apply inset-0 absolute opacity-10 rounded-lg block;
    content: '';
    background-image: linear-gradient(180deg,rgba(255,255,255,1),rgba(255,255,255,0) 100%);
    transition: opacity 0.5s ease 0s;
  }
  &:hover {
    @apply cursor-pointer;
    .chevron, .stem {
      transform: translateX(0px);
    }
    .stem {
      stroke-dashoffset: 0;
    }
    &::after {
      opacity: 0.15;
    }
  }
  &:active {
    box-shadow: 0 0 0 1px rgba(83,120,255,1),0 1px 3px rgba(0,0,0,0.3),0 0 0 0 rgba(212,227,247,1);
    .chevron, .stem {
      transform: translateX(2px);
    }
    &::after {
      opacity: 0.05;
    }
  }
}
.btn-inline {
  @apply text-sm gap-1 items-center flex z-10 relative mt-0.5;
  transition: transform 0.2s ease 0s, opacity 0.2s ease 0s;
  &.loading {
    opacity: 0;
    transform: translateY(12px) scale(0.75);
  }
}
.btn-arrow {
  @apply h-4 stroke-current inline-block -mr-1 mb-0.5;
  .chevron {
    transform: translateX(-3px);
    transition: transform 0.15s ease 0s;
  }
  .stem {
    stroke-dasharray: 10;
    stroke-dashoffset: 10;
    transform: translateX(-3px);
    transition: stroke-dashoffset 0.15s ease 0s, transform 0.15s ease 0s;
  }
}
.btn-ghost {
  @apply relative text-232730 rounded-lg px-4 h-9 m-px font-medium outline-none whitespace-nowrap 
  cursor-pointer text-center leading-4 items-center justify-center inline-flex;
  background-color: rgb(var(--ghost-bg) / 0.8);
  backdrop-filter: blur(2px);
  box-shadow: var(--ghost-shadow);
  transition: box-shadow 0.2s ease 0s, background-color 0.2s ease 0s, border-color 0.2s ease 0s;
  &:hover {
    background-color: rgb(var(--ghost-bg-hover) / 1);
    box-shadow: var(--ghost-shadow-hover);
  }
}
.background-gradient {
  @apply absolute top-1/2 hue-rotate-0;
  width: 150vw;
  left: 80%;
  height: 1024px;
  transform: translate3d(-50%, -50%, 0px);
  -webkit-mask-image: radial-gradient(farthest-side at 50% 50%, rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0));
  mask-image: radial-gradient(farthest-side at 50% 50%, rgba(0, 0, 0, 0.4), rgba(0, 0, 0, 0));
  background-image: linear-gradient(90deg,rgb(var(--gradient-a)),rgb(var(--gradient-b)));
  animation-name: background-gradient-animation;
  animation-duration: 8s;
  animation-iteration-count: infinite;
  @keyframes background-gradient-animation {
	  0% {filter: hue-rotate(8deg)}
	  50% {filter: hue-rotate(-25deg)}
	  100% {filter: hue-rotate(8deg)}
  }
}
.background-gradient-pattern {
  @apply absolute inset-0 mix-blend-overlay;
  background-image: url('/img/guilloche.svg');
  background-size: 20px;
}


.btn-primary svg,
.btn-ghost svg {
  --icon-color: currentColor;
  --icon-size: 20px;
  flex: 0 0 20px;
}
.btn-spinner {
  @apply absolute left-1/2 top-1/2 opacity-0 block;
  margin: -10px 0px 0px -10px;
  transition: transform 0.2s ease 0s, opacity 0.2s ease 0s;
  transform: translateY(-12px) scale(0.75);
  width: var(--icon-size);
  height: var(--icon-size);
  opacity: 0;
  &.loading {
    transform: none;
    opacity: 1;
  }
}
.spinner-rotate {
  animation: 1s linear 0s infinite normal none running rotate;
  transform-origin: 50% 50%;
  @keyframes rotate {
	  0% {transform: rotate(0deg)}
	  100% {transform: rotate(360deg)}
  }
}
.spinner-arc {
  stroke-dasharray: 38px;
  stroke-dashoffset: 114px;
  animation: 2s linear 0s infinite normal none running offset;
  @keyframes offset {
    50% {stroke-dashoffset: 96px}
  }
}
.layout-root {
  @apply relative min-h-screen overflow-x-hidden bg-fcfcfc text-12161e;
  font-family: 'SuisseIntl', sans-serif;
}
.layout-bg {
  @apply absolute inset-0 pointer-events-none;
}
.layout-shell {
  @apply relative z-10 flex min-h-screen flex-col md:flex-row;
}
.sidebar {
  @apply w-full md:w-64 shrink-0 px-6 py-6 backdrop-blur-xl border-b md:border-b-0 md:border-r flex flex-col gap-6;
  background-color: rgb(var(--surface-sidebar) / 0.9);
  border-color: rgb(var(--border-muted) / 0.1);
}
.sidebar-header {
  @apply flex items-center justify-between gap-3;
}
.sidebar-logo {
  @apply text-2xl font-semibold tracking-[-0.02em] text-12161e;
}
.theme-toggle {
  @apply flex items-center gap-2 text-xs font-semibold rounded-md px-2 py-1 transition duration-200 text-91949b cursor-pointer;
  background-color: rgb(var(--surface-3) / 0.6);
  border: 1px solid rgb(var(--border-soft) / 0.08);
}
.theme-toggle:hover {
  @apply text-12161e;
  background-color: rgb(var(--surface-4) / 1);
  box-shadow: var(--shadow-soft);
}
.theme-toggle-icon {
  @apply text-sm;
}
.theme-toggle-label {
  @apply hidden sm:inline;
}
.sidebar-user {
  @apply rounded-lg border px-3 py-2;
  background-color: rgb(var(--surface-3) / 0.6);
  border-color: rgb(var(--border-soft) / 0.08);
}
.sidebar-user-label {
  @apply text-[10px] uppercase tracking-[0.2em] text-91949b;
}
.sidebar-user-name {
  @apply mt-1 text-sm font-semibold text-12161e truncate;
}
.sidebar-nav {
  @apply flex flex-col gap-1;
}
.sidebar-logout {
  @apply mt-auto pt-6;
}
.sidebar-logout-button {
  @apply text-232730;
  background-color: rgb(var(--surface-3) / 1);
  box-shadow: var(--shadow-soft);
}
.sidebar-logout-button:hover {
  background-color: rgb(var(--surface-4) / 1);
}
.sidebar-link {
  @apply flex items-center gap-3 rounded-md px-3 py-2 text-sm font-semibold text-91949b transition duration-200;
}
.sidebar-link:hover {
  @apply text-12161e;
  background-color: rgb(var(--surface-3) / 1);
  box-shadow: var(--shadow-float);
}
.sidebar-link.router-link-exact-active {
  @apply text-12161e;
  background-color: rgb(var(--surface-3) / 1);
  box-shadow: var(--shadow-float-strong);
}
.sidebar-emoji {
  @apply text-base;
}
.layout-content {
  @apply flex-1 px-6 py-12 md:py-20;
}
.layout-content-inner {
  @apply w-full max-w-6xl mx-auto;
}
.card-surface {
  @apply backdrop-blur border;
  background-color: rgb(var(--surface-card) / 0.9);
  border-color: rgb(var(--border-soft) / 0.05);
  box-shadow: var(--shadow-card);
}
.search-input {
  @apply text-12161e;
  background-color: rgb(var(--surface-search) / 0.8);
  border: 1px solid rgb(var(--border-muted) / 0.1);
}
